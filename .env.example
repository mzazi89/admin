# ── MZAZI TECH ADMIN — Environment Variables ────────────
# Copy to .env.local (never commit real values)
# Shares the SAME Neon database as the main website.

# Neon Postgres (same as the main site)
DATABASE_URL="postgresql://user:pass@host/neondb?sslmode=require"

# Admin login (same values as the main site uses for /api/admin)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
# Optional: bcrypt hash of ADMIN_PASSWORD (takes precedence when set)
ADMIN_PASSWORD_HASH=""
ADMIN_JWT_SECRET="change-me-to-a-long-random-string"
